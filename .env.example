# Frontend (Vite). Somente valores PÚBLICOS: tudo aqui vai para o navegador.
# Nunca coloque service_role, secret key, chave do Google ou de pagamento aqui.

# Projeto Supabase (Settings > API)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# URL pública da loja (usada nos links do /embed e em canonical/OG)
VITE_SITE_URL=http://localhost:5173

# Caminho base. "/" com domínio próprio; "/nome-do-repo/" em usuario.github.io/nome-do-repo
VITE_BASE_PATH=/

# Analytics (opcionais; carregados somente após consentimento)
VITE_GTM_ID=
VITE_GA4_ID=
VITE_META_PIXEL_ID=

# Origens do site pai autorizadas a receber eventos do /embed via postMessage
# (ex.: https://www.suamarca.com.br). Vazio = eventos sem dados pessoais para qualquer origem.
VITE_EMBED_PARENT_ORIGINS=
