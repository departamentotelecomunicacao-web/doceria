# Variáveis das Edge Functions (local: copie para supabase/functions/.env).
# Em produção configure com: supabase secrets set --env-file ./supabase/functions/.env.production
# NUNCA versione valores reais.

# Origens autorizadas a chamar as funções pelo navegador (CORS), separadas por vírgula.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Provedor de rotas (google). A chave fica somente no backend.
ROUTING_PROVIDER=google
GOOGLE_MAPS_API_KEY=
# Opcional: endpoint alternativo (usado pelos testes E2E com o stub local).
# GOOGLE_ROUTES_ENDPOINT=http://host.docker.internal:54400/directions/v2:computeRoutes
ROUTING_TIMEOUT_MS=8000

# Cache de distância por endereço (horas).
ROUTE_CACHE_TTL_HOURS=168
# Teto global de chamadas pagas à API de mapas por hora (proteção de custo).
ROUTING_MAX_CALLS_PER_HOUR=300

# Sal usado no hash do IP para rate limit (gere um valor aleatório longo).
RATE_LIMIT_SALT=troque-por-um-valor-aleatorio
QUOTE_RATE_LIMIT_PER_10_MIN=30
ORDER_RATE_LIMIT_PER_10_MIN=12
