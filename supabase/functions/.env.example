# Variáveis das Edge Functions (local: `npm run env:local` copia para supabase/functions/.env).
# Produção: Supabase > Edge Functions > Secrets (ou `supabase secrets set --env-file ...`).
# NUNCA versione valores reais.

# Endereço público da loja (reserva de CORS quando ALLOWED_ORIGINS está vazio).
SITE_URL=http://localhost:5173

# Origens autorizadas a chamar as funções pelo navegador (CORS), separadas por vírgula.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Sal usado no hash do IP para o limite de pedidos (gere um valor aleatório longo).
RATE_LIMIT_SALT=troque-por-um-valor-aleatorio
ORDER_RATE_LIMIT_PER_10_MIN=12
